<aside class="d-flex flex-column flex-shrink-0 p-3 text-bg-dark" style="width: 250px; min-height: 100vh;">

    {# Brand #}
    <a
        href="{{ path('app_home') }}"
        class="d-flex align-items-center mb-4 text-white text-decoration-none"
    >
        <span class="bg-success rounded-3 p-2 me-2">
            <i class="bi bi-wallet2 fs-5"></i>
        </span>

        <div>
            <span class="fs-5 fw-semibold d-block">
                Finance
            </span>

            <small class="text-secondary">
                Management
            </small>
        </div>
    </a>


    {# Main Navigation #}
    <div class="text-secondary small fw-semibold text-uppercase mb-2 px-2">
        Main
    </div>

    <ul class="nav nav-pills flex-column gap-1">

        <li class="nav-item">
            <a
                href="{{ path('app_home') }}"
                class="nav-link text-white {{ app.request.attributes.get('_route') == 'app_home' ? 'active' : '' }}"
            >
                <i class="bi bi-grid-1x2 me-2"></i>
                Dashboard
            </a>
        </li>

        <li>
            <a
                href="{{ path('app_transaction_index') }}"
                class="nav-link text-white {{ app.request.attributes.get('_route') starts with 'app_transaction' ? 'active' : '' }}"
            >
                <i class="bi bi-arrow-left-right me-2"></i>
                Transactions
            </a>
        </li>

        <li>
            <a
                href="{{ path('app_category_index') }}"
                class="nav-link text-white {{ app.request.attributes.get('_route') starts with 'app_category' ? 'active' : '' }}"
            >
                <i class="bi bi-tags me-2"></i>
                Categories
            </a>
        </li>

    </ul>


    {# Analysis #}
    <div class="text-secondary small fw-semibold text-uppercase mt-4 mb-2 px-2">
        Analysis
    </div>

    <ul class="nav nav-pills flex-column gap-1">
        <li>
            <a href="{{path('app_report_daily')}}" class="nav-link text-white">
                <i class="bi bi-bar-chart me-2"></i>
                Daily Report
            </a>
        </li>
        <li>
            <a href="{{path('app_report_monthly')}}" class="nav-link text-white">
                <i class="bi bi-bar-chart me-2"></i>
                Monthly Report
            </a>
        </li>
        <li>
            <a href="{{path('app_report_yearly')}}" class="nav-link text-white">
                <i class="bi bi-bar-chart me-2"></i>
                Yearly Report
            </a>
        </li>

    </ul>


    {# Bottom #}
    <div class="mt-auto">

        <hr class="text-secondary">

        <a href="#" class="nav-link text-white">
            <i class="bi bi-gear me-2"></i>
            Settings
        </a>

        <div class="mt-3 px-2">
            <small class="text-secondary">
                Internal Finance System
            </small>

            <br>

            <small class="text-secondary">
                v1.0
            </small>
        </div>

    </div>

</aside>
