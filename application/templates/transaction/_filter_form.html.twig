{{ form_start(filter_form) }}

<div class="row">
    <div class="col-md-2">
        {{ form_row(filter_form.type) }}
    </div>

    <div class="col-md-3">
        {{ form_row(filter_form.category) }}
    </div>

    <div class="col-md-2">
        {{ form_row(filter_form.fromDate) }}
    </div>

    <div class="col-md-2">
        {{ form_row(filter_form.toDate) }}
    </div>

     <div class="col-md-3 d-flex flex-column align-items-start gap-2">
        {{ form_widget(filter_form.filter) }}

        <a href="{{ path('app_transaction_index') }}"
           class="btn btn-secondary">
            Reset filters
        </a>
    </div>
    

</div>

{{ form_end(filter_form) }}