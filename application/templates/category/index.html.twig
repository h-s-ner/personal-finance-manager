{% extends 'base.html.twig' %}
{% import 'macros/actions.html.twig' as actions %}
{% block title %}Category index{% endblock %}

{% block body %}
    <h1>Category index</h1>

    <table class="table">
        <thead class="table-light">
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Description</th>
                <th>Color</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for category in categories %}
            <tr>
                <td>{{ category.id }}</td>
                <td>{{ category.name }}</td>
                <td>{{ category.description }}</td>
                <td>
                    <div class="btn btn-sm btn-primary-outline" style="border: 1px solid {{ category.color }}">
                        <i class="bi bi-circle-fill"
                            style="color: {{ category.color }};"
                        ></i>
                    </div>
                </td>
                <td>
                    {{ actions.show(path('app_category_show', {'id': category.id})) }}
                    {{ actions.edit(path('app_category_edit', {'id': category.id})) }}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    {{ actions.create(path('app_category_new')) }}
{% endblock %}
